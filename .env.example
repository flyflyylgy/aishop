# ============================================================
# 环境变量配置模板
# 复制本文件为 .env 并填入实际值：cp .env.example .env
# .env 文件已被 .gitignore 排除，不会提交到仓库
# ============================================================

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=cloude_shop
MYSQL_USER=root
MYSQL_PASSWORD=           # 填入你的 MySQL 密码

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=           # 无密码留空

# ---- RabbitMQ ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- JWT 密钥（生产必须设置，>= 32 字节随机字符串）----
# 生成方式：openssl rand -base64 48
JWT_SECRET=

# ---- 管理员初始密码（仅首次启动创建超管时使用）----
ADMIN_INIT_PASSWORD=

# ---- CORS 允许来源（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
